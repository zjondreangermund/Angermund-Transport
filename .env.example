DATABASE_URL=postgresql://user:password@host:5432/angermund
JWT_SECRET=replace-with-at-least-32-random-characters
INITIAL_ADMIN_EMAIL=admin@angermund.local
INITIAL_ADMIN_PASSWORD=replace-this-password
TELEMATICS_WEBHOOK_TOKEN=replace-with-random-token
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
WHATSAPP_ALERT_TO=
RESEND_API_KEY=
ALERT_EMAIL_TO=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:angermundtransport@iway.na
PUBLIC_BASE_URL=http://localhost:3000
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Optional AI receipt/slip scanning. OCR remains the fallback when no key is configured.
OPENAI_API_KEY=
RECEIPT_AI_PRIMARY_MODEL=gpt-6-luna
RECEIPT_AI_ESCALATION_MODEL=gpt-6-sol
RECEIPT_AI_SOL_THRESHOLD=82

# Optional Traccar position-forwarding authentication. Use the same value in Traccar forward.header as X-Traccar-Token.
TRACCAR_FORWARD_TOKEN=
